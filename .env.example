# SigiloPay (https://app.sigilopay.com.br/docs) — NUNCA coloque os valores reais
# neste arquivo nem em nenhum arquivo versionado no Git. Configure os valores
# reais direto no painel do projeto na Vercel (Settings > Environment Variables).

SIGILOPAY_BASE_URL=https://app.sigilopay.com.br/api/v1
SIGILOPAY_PUBLIC_KEY=
SIGILOPAY_SECRET_KEY=
SIGILOPAY_HTTP_TIMEOUT_MS=10000

# Token que a SigiloPay envia no campo "token" do payload do webhook, usado
# para validar autenticidade das notificações recebidas em /api/webhooks/sigilopay.
SIGILOPAY_WEBHOOK_TOKEN=

# URL pública e ESTÁVEL do seu endpoint de webhook. É enviada como callbackUrl
# em toda cobrança criada — a doc limita a 20 webhooks por integração, então
# não gere uma URL diferente por pedido.
SIGILOPAY_WEBHOOK_URL=https://SEU-DOMINIO.com.br/api/webhooks/sigilopay

# Vercel KV (Redis) — se você conectar um KV Store ao projeto na Vercel, estas
# variáveis (KV_REST_API_URL, KV_REST_API_TOKEN, etc.) são injetadas
# automaticamente. Não é preciso preenchê-las manualmente aqui.
